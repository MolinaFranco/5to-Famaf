        <mxCell id="0Utk2qZ2YowuYWjOl8Ev-49" value="Generar targets gsm:&lt;div&gt;h_inputs&lt;/div&gt;&lt;div&gt;taget_mu&lt;/div&gt;&lt;div&gt;target sigma&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Σ_post = [C⁻¹ + (z²/σ²)A^TA]⁻¹&lt;/div&gt;&lt;div&gt;μ_post = (z/σ²)Σ_post·A^T·x&lt;/div&gt;&lt;div&gt;h_vec = [h_E, h_I]&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=#36393d;fillColor=#eeeeee;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
