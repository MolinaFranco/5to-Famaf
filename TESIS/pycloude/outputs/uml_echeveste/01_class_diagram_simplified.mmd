%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#f5f5f5', 'primaryTextColor': '#212121', 'primaryBorderColor': '#616161', 'lineColor': '#424242', 'secondaryColor': '#eeeeee', 'tertiaryColor': '#e0e0e0'}}}%%

classDiagram
    direction TB

    %% ============================================
    %% CLASE BASE ABSTRACTA
    %% ============================================
    class SKNMSIMethodABC {
        <<abstract>>
        +run()* NDResult
        +set_random(rng)
        ...
    }

    %% ============================================
    %% CLASE PRINCIPAL SSN
    %% ============================================
    class Echeveste2020 {
        -_N_E: int
        -_N_I: int
        -_integrator: SSNIntegrator
        -_W_exact: ndarray
        -_Sigma_eta: ndarray
        -_is_trained: bool
        ...

        +__init__(N_E, N_I, tau_e, tau_i, ...)
        +train(gsm_model, ...)
        +run(stimulus_contrast, ...) NDResult
        +load_parameters()
        +save_parameters(output_dir)
        +build_connectivity_matrix(params)
        ...
    }

    %% ============================================
    %% INTEGRADOR SSN
    %% ============================================
    class SSNIntegrator {
        <<dataclass>>
        +tau_e: float
        +tau_i: float
        +n: float
        +k: float

        +supralinear_activation(u) ndarray
        +__call__(u_e, u_i, t, W, h, eta) tuple
    }

    %% ============================================
    %% MODELO GENERATIVO GSM
    %% ============================================
    class GSM {
        +A: ndarray
        +C: ndarray
        +W_ff: ndarray
        +alpha_h, beta_h, gamma_h: float
        ...

        +generate_stimulus_patch(contrast, ...) dict
        +generate_h_input_efficient(x) ndarray
        +compute_posterior_moments(x, z_map) tuple
        ...
    }

    %% ============================================
    %% DATA LOADERS
    %% ============================================
    class EchevesteDataLoader {
        +data_path: Path

        +load_gabor_filters() ndarray
        +load_ssn_connectivity_parameters() dict
        +load_noise_covariance() ndarray
        +load_connectivity_matrix() ndarray
        ...
    }

    class GSMDataLoader {
        +data_path: Path

        +load_gabor_filters() ndarray
        +load_prior_covariance() ndarray
        +load_h_vec_transformed(idx) ndarray
        ...
    }

    %% ============================================
    %% RESULTADO
    %% ============================================
    class NDResult {
        <<from core>>
        +times_: ndarray
        +positions_: ndarray
        +get_modes() DataFrame
    }

    %% ============================================
    %% RELACIONES
    %% ============================================
    SKNMSIMethodABC <|-- Echeveste2020 : hereda
    Echeveste2020 *-- SSNIntegrator : contiene
    Echeveste2020 ..> GSM : usa
    Echeveste2020 ..> EchevesteDataLoader : carga datos
    Echeveste2020 ..> NDResult : retorna
    GSM ..> GSMDataLoader : carga datos
