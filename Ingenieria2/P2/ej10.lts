const N = 2 //sillas 

// PELUQUERO = (iniciar_corte -> CORTANDO | DURMIENDO),
// CORTANDO = termino -> PELUQUERO,
// DURMIENDO = despertar -> PELUQUERO.
// lo lei mal, el cliente despierta al peluquero no uno al otro

PELUQUERO = (
    realizar_corte_cliente -> PELUQUERO 
    |realizar_corte_pelado -> PELUQUERO 
    |dormir -> despertar -> PELUQUERO
).

SALA_ESPERA = SALA_ESPERA[0][0],
SALA_ESPERA[c:0..N][p:0..N] = (
    when c+p<N cliente_nuevo -> SALA_ESPERA[c+1][p]
    |when c+p<N pelado_nuevo -> SALA_ESPERA[c][p+1]
    |when p>0 realizar_corte_pelado -> SALA_ESPERA[c][p-1]
    |when p>0 despertar_peluquero -> realizar_corte_pelado -> SALA_ESPERA[c][p-1]              
    |when (c>0 && p==0) realizar_corte_cliente -> SALA_ESPERA[c-1][p] 
    |when (c>0 && p==0) despertar_peluquero -> realizar_corte_cliente -> SALA_ESPERA[c-1][p]    
).


||PELUQUERIA = (
    {figaro, mateo}:PELUQUERO
    ||{figaro, mateo}::sala:SALA_ESPERA
)/{
    cliente_nuevo/{mateo.sala.cliente_nuevo, figaro.sala.cliente_nuevo},
    pelado_nuevo/{mateo.sala.pelado_nuevo, figaro.sala.pelado_nuevo},
    
    mateo.despertar/{mateo.sala.despertar_peluquero},
    figaro.despertar/{figaro.sala.despertar_peluquero},

    figaro.realizar_corte_cliente/{figaro.sala.realizar_corte_cliente},
    mateo.realizar_corte_cliente/{mateo.sala.realizar_corte_cliente},
    figaro.realizar_corte_pelado/{figaro.sala.realizar_corte_pelado},
    mateo.realizar_corte_pelado/{mateo.sala.realizar_corte_pelado}
}.


